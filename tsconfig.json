{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "cli/**/*.ts",
    "lib/**/*.ts",
    "server/**/*.ts",
    "tools/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "index.ts"
  ],
  "exclude": ["node_modules", "dist", "_external"]
}
